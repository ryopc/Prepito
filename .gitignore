.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Expo
.expo/
expo-env.d.ts
# expo prebuild で生成されるネイティブプロジェクト (CI でのみ生成する)
# 注意: ルート起点に固定する。 broadening すると
# fastlane/metadata/android/ (F-Droid 掲載用メタデータ) まで除外されてしまう。
/ios/
/packages/app/ios/
/android/
/packages/app/android/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Misc
*.tgz
.cache/
.temp/
tmp/

# Environment
.env
.env.local
.env.*.local

# EAS credentials (eas.json はコミット対象)
credentials.json

# Patches
# patches/ は pnpm の patchedDependencies 用にコミット対象とする
# （Gradle 8.0 で削除された API の回避パッチを含むため必須）

# F-Droid ビルド時に生成するビルドフラグファイル（コミットしない）
.build-flags.json

# リリース署名鍵（コミットしない。docs/release-signing.md 参照）
# 生成した鍵は GitHub Secret（ANDROID_KEYSTORE_BASE64）に入れて管理する
*.keystore
*.jks
*.p12
prepito-release.keystore.b64

# Python
__pycache__/
*.py[cod]
