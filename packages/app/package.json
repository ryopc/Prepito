{
  "name": "@prepito/app",
  "version": "0.0.1",
  "description": "Prepito - koshi platform reference client (React Native / Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start -c",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:interop": "node scripts/libsignal-interop.cjs",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.0.1",
    "@prepito/shared": "workspace:*",
    "@ryopc/koshi": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.0",
    "expo-crypto": "~13.0.0",
    "expo-device": "~6.0.0",
    "expo-file-system": "~17.0.0",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.0",
    "expo-notifications": "~0.28.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-sqlite": "~14.0.0",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "~3.31.0",
    "react-native-url-polyfill": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@react-native/gradle-plugin": "0.74.87",
    "@signalapp/libsignal-client": "^0.40.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "~18.2.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0",
    "sucrase": "^3.34.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryopc/Prepito.git",
    "directory": "packages/app"
  },
  "license": "MIT",
  "author": "ryopc",
  "keywords": [
    "prepito",
    "koshi",
    "messenger",
    "react-native",
    "expo",
    "e2e-encryption",
    "signal-protocol",
    "p2p"
  ],
