{
  "name": "@prepito/app",
  "version": "0.0.1",
  "description": "Prepito - koshi platform reference client (React Native / Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start -c",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "prebuild": "expo prebuild",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@prepito/shared": "workspace:*",
    "@ryopc/koshi": "workspace:*",
    "@signalapp/libsignal-client": "^0.40.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-device": "~6.0.0",
    "expo-file-system": "~17.0.0",
    "expo-local-authentication": "~14.0.0",
    "expo-notifications": "~0.28.0",
    "expo-secure-store": "~13.0.0",
    "expo-sqlite": "~14.0.0",
    "expo-task-manager": "~11.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "~3.31.0",
    "react-native-url-polyfill": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.2.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "patch-package": "^8.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryopc/Prepito.git",
    "directory": "packages/app"
  },
  "license": "MIT",
  "author": "ryopc",
  "keywords": [
    "prepito",
    "koshi",
    "messenger",
    "react-native",
    "expo",
    "e2e-encryption",
    "signal-protocol",
    "p2p"
  ],
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "expo": {
    "name": "Prepito",
    "slug": "prepito",
    "scheme": "prepito",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prepito.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "PrepitoでFace ID/Touch IDを使用してアプリをロック解除します",
        "NSCameraUsageDescription": "プロフィール画像やチャットで写真を撮影・選択するためにカメラへのアクセスを許可してください",
        "NSPhotoLibraryUsageDescription": "プロフィール画像やチャットで写真を選択するために写真ライブラリへのアクセスを許可してください",
        "NSMicrophoneUsageDescription": "ボイスメッセージ送信のためにマイクへのアクセスを許可してください"
      },
      "associatedDomains": ["applinks:prepito.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.prepito.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": { "scheme": "prepito" },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" },
          "android": { "enableProguardInReleaseBuilds": true }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}